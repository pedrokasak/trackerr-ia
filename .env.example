# Provider de LLM ativo: gemini | claude | groq | nvidia
LLM_PROVIDER=groq

# Preencha apenas a chave do provider selecionado acima (as demais podem ficar vazias)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# NVIDIA NIM (https://integrate.api.nvidia.com) — API OpenAI-compatible,
# alternativa ao Groq (ver TRA-71: conta Groq atual bloqueia todo modelo
# de chat a nivel de projeto). NVIDIA_MODEL e opcional, sobrescreve o
# default (deepseek-ai/deepseek-v4-flash-0731) sem editar codigo — ver
# NvidiaProvider.ALT_MODEL em benchmark/providers/nvidia_provider.py pra
# outra opcao pronta (z-ai/glm-5.2).
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Postgres proprio do RAG (TRA-35) — banco dedicado ao trackerr-ia,
# independente do MongoDB transacional do server. Aceita postgresql:// ou
# postgresql+asyncpg://, ambos sao normalizados em rag/database.py.
RAG_DATABASE_URL=
